{
  "name": "undercut-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "./start.sh",
    "dev": "node tools/serve/dev.mjs",
    "lint": "eslint . && prettier --check . && node tools/ci/check-names.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/audio/tsconfig.json && tsc --noEmit -p tools/audio/browser-check/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:physics": "vitest run --project physics",
    "test:rooms": "vitest run --project rooms && vitest run --project rooms-soak-short",
    "test:browser": "playwright test",
    "test:deploy": "vitest run --project deploy",
    "test:soak": "npm run test:soak:sim && npm run test:soak:rooms",
    "test:soak:sim": "vitest run --project soak",
    "test:soak:rooms": "vitest run --project rooms-soak",
    "build": "npm run build -w @undercut/web && node tools/serve/precompress.mjs && node tools/budget/check.mjs",
    "deploy": "npm run build && node tools/deploy/stage.mjs && wrangler deploy",
    "deploy:check": "npm run build && node tools/deploy/check.mjs",
    "audio:render": "node tools/audio/render.mjs",
    "audio:browser-check": "node tools/audio/browser-check/run.mjs",
    "check:assets": "node tools/assets/check-licences.mjs",
    "assets:build": "python3 tools/assets/build_textures.py",
    "check:secrets": "bash tools/ci/gitleaks.sh",
    "telemetry": "node tools/telemetry/cli.mjs",
    "ai:build": "node tools/ai/build.mjs",
    "ai:plot": "python3 tools/ai/plot_line.py",
    "track:build": "python3 tools/track-pipeline/build.py",
    "track:plot": "python3 tools/track-pipeline/plot.py",
    "track:bench": "vitest bench --run --project unit packages/track/bench",
    "car:build": "node tools/car/build.mjs",
    "car:preview": "node tools/car/preview/capture.mjs",
    "shots": "node tools/screenshots/shots.mjs",
    "props:build": "node tools/props/build.mjs",
    "props:preview": "node tools/props/capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "selfsigned": "5.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "ws": "8.23.0"
  }
}
